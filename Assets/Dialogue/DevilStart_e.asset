    weakShake: 0
  - speaker: Devil
    text: "You\u2019ve already finished your thesis\u2026?"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Player
    text: "I\u2019m done, so let me graduate."
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Devil
    text: "Hahahaha!  \r\nYou really think that\u2019s all it takes?"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Devil
    text: You wrote a thesis, sure.
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Devil
    text: "But do you even know where the professor\nwho\u2019s supposed to approve
      it is?"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Player
    text: "Don\u2019t tell me\u2026\nYou locked up the professor too?"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Devil
    text: "Did you really think I\u2019d let you go that easily?"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Devil
    text: "I\u2019m the final step."
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Devil
    text: 'You will not graduate

      unless you defeat me!!!!'
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Player
    text: "Someone like you?\nI\u2019ll wipe you out in no time."
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
