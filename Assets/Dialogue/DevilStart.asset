  m_Script: {fileID: 11500000, guid: 249731c3981dc69468efe9e0a7db29d6, type: 3}
  m_Name: DevilStart
  m_EditorClassIdentifier: 
  id: 
  lines:
  - speaker: Devil
    text: ...
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Devil
    text: ...
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Devil
    text: "\uBC8C\uC368 \uB17C\uBB38\uC744 \uB2E4 \uC791\uC131\uD588\uB2E8 \uB9D0\uC778\uAC00"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Player
    text: "\uB2E4 \uC791\uC131\uD588\uC73C\uB2C8, \uC878\uC5C5\uD558\uAC8C \uD574\uC918."
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Devil
    text: "\u314B\u314B\u314B\u314B \uD558!"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Devil
    text: "\uB17C\uBB38\uB9CC \uC791\uC131\uD558\uBA74 \uB05D\uC778 \uC904 \uC544\uB098?"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Devil
    text: "\uB17C\uBB38 \uC81C\uCD9C\uD558\uACE0\uB3C4 \uAC70\uCCD0\uC57C \uD560
      \uACFC\uC815\uC774 \uC0B0\uB354\uBBF8\uB77C\uACE0!"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Player
    text: "\uADF8\uAC74 \uB0B4\uAC00 \uC54C\uC544\uC11C \uD560 \uC77C\uC774\uC57C.
      \n\uC774\uC81C \uB0B4\uBCF4\uB0B4\uC918."
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Devil
    text: "\uD489, \uB0B4\uAC00 \uB110 \uADF8\uB807\uAC8C \n\uC27D\uAC8C \uBCF4\uB0B4\uC904
      \uAC70\uB77C \uC0DD\uAC01\uD588\uB098?"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Devil
    text: "\uB9C8\uC9C0\uB9C9\uC740 \uB098\uB2E4. "
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Devil
    text: "\uB098\uB97C \uC774\uACA8\uC57C \uC878\uC5C5\uC744 \uD560 \uC218 \uC788\uC744\uAC83\uC774\uB2E4!!!!"
    requiresName: 0
    shakeCamera: 1
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Player
    text: "\uB2C8\uAE4C\uC9D3\uAEBC \uAE08\uBC29 \uCE58\uC6B8 \uC218 \uC788\uC5B4."
    requiresName: 0
    shakeCamera: 1
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
