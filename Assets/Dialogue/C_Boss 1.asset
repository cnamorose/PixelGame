    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: cboss
    text: "\uD398\uC77C\uD55C\uD14C \uD55C\uC18C\uB9AC \uB4E3\uACA0\uAD70."
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Player
    text: "\uB204\uAD6C\uC57C?"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: cboss
    text: "\uB531 \uBCF4\uBA74 \uBAB0\uB77C?"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: cboss
    text: "\uB108 \uC55E\uAE38 \uB9C9\uC744\uAD34\uBB3C\uC774\uC9C0 "
