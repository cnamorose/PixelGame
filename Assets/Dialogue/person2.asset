%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 249731c3981dc69468efe9e0a7db29d6, type: 3}
  m_Name: person2
  m_EditorClassIdentifier: 
  id: 
  lines:
  - speaker: Player
    text: "\uAD50\uC218\uB2D8\u2026?! \uAD50\uC218\uB2D8\uC774 \uC65C \uC5EC\uAE30\uC11C
      \uB098\uC624\uC2DC\uB294 \uAC70\uC8E0\u2026?!"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Professor
    text: "\uC5B4, {name} \uD559\uC0DD\u2026? \uC790\uB124\uAC00 \uB0A0 \uAD6C\uD558\uB7EC
      \uC628 \uAC74\uAC00?\r"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Player
    text: "\uC544 \uADF8\uAC8C,,\uC804 \uADF8\uB0E5 \uC81C \uC7A5\uBE44 \uBD80\uC21C
      \uC545\uB9C8 \uC7A1\uACE0\\n\uB118\uC5B4\uC628 \uAC70\uAE34 \uD55C\uB370\u2026\r"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Player
    text: "\uAD50\uC218\uB2D8\uC774 \uC5EC\uAE30 \uAC07\uD600 \uACC4\uC2E0 \uC904\uC740
      \uAFC8\uC5D0\uB3C4 \uBAB0\uB790\uC5B4\uC694.\r\r"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Professor
    text: "\uADF8\uB7AC\uAD70\u2026 \uB09C \uC5F0\uAD6C\uC2E4\uC5D0\uC11C \uC7A0\uAE50
      \uB208 \uBD99\uC600\uC744 \uBFD0\uC778\uB370,\r"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Professor
    text: "\uC815\uC2E0 \uCC28\uB824\uBCF4\uB2C8 \uC774 \uC774\uC0C1\uD55C \uACF3\uC5D0
      \uAC07\uD600 \uC788\uC5C8\uC5B4.\\n\uB0A0 \uAD6C\uD574\uC918\uC11C \uC815\uB9D0
      \uACE0\uB9D9\uB2E4."
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Player
    text: "(..\uB098 \uD398\uC77C \uBABB \uC7A1\uC558\uC73C\uBA74...)"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Player
    text: "(\uC9C4\uC9DC \uC9C0\uB3C4\uAD50\uC218\uB2D8 \uCEE8\uD38C \uBABB\uBC1B\uACE0\\n\uC601\uC6D0\uD788
      \uC878\uC5C5 \uBABB \uD560 \uBED4\uD55C \uAC74\uAC00\u2026?)\r"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Professor
    text: "{name} \uD559\uC0DD? \\n\uBB34\uC2A8 \uC0DD\uAC01\uC744 \uADF8\uB9AC \uBA4D\uD558\uB2C8
      \uD558\uACE0 \uC788\uC5B4?\r\n"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Player
    text: "\uC544, \uC557! \uC544\uB2D9\uB2C8\uB2E4 \uAD50\uC218\uB2D8!\\n\uC5EC\uAE30
      \uC704\uD5D8\uD558\uB2C8\uAE4C \uC77C\uB2E8 \uBE68\uB9AC \uD0C8\uCD9C\uD558\uC138\uC694! "
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Player
    text: "\uC800\uB3C4 \uBC14\uB85C \uB17C\uBB38 \uC900\uBE44\uD574\uC11C \uC5F0\uAD6C\uC2E4\uB85C
      \uCC3E\uC544\uBD59\uACA0\uC2B5\uB2C8\uB2E4!"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Professor
    text: "\uADF8\uB798, \uC774\uB530 \uBCF4\uC790."
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
