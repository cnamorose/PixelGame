    shakeCamera: 1
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Player
    text: "\uC11C\uB860\uC774 \uAE38\uB2E4. \uB098 \uBC14\uBE60"
