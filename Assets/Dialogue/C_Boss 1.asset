    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: Player
    text: "...\uADF8\uB798\uBD24\uC790 \uD0A4\uBCF4\uB4DC \uC8FC\uC81C\uC5D0"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: cboss
    text: "\uD0A4\uBCF4\uB4DC.... \uC8FC\uC81C\uC5D0...?"
    requiresName: 0
    shakeCamera: 0
    changeDevilSpriteOnEnd: 0
    devilSpriteOnEnd: {fileID: 0}
    weakShake: 0
  - speaker: cboss
    text: "\uAC10\uD788!!!! \uB2C8\uAC00!!!!!!!!!"
